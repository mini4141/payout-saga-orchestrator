# Copy to .env for local overrides (docker compose reads it automatically).
POSTGRES_PASSWORD=payout
DATABASE_URL=postgres://payout:payout@postgres:5432/payout?sslmode=disable
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=payout
MOCKS_URL=http://mocks:8090
RECEIVER_URL=http://receiver:8095/events
API_TOKEN=dev-token
API_ADDR=:8080
OPS_UI_ADDR=:8081
LOG_LEVEL=info
OTEL_TRACES_STDOUT=true
